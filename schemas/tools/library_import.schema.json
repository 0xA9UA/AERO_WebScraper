    "import_root": {
      "default": "inbox",
      "title": "Import Root",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "kind": {
      "default": "file",
      "enum": [
        "file",
        "folder",
        "repository"
      ],
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "publication_date": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "provenance_role": {
      "default": "original",
      "enum": [
        "original",
        "extracted",
        "decompiled",
        "model-generated"
      ],
      "title": "Provenance Role",
      "type": "string"
    },
    "repository_revision": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Revision"
    }
  },
  "required": [
    "relative_path"
  ],
  "title": "ImportArgs",
  "type": "object"
