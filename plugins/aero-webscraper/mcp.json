{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aero-library": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/runtime/launch.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "AERO_LIBRARY_ROOT": "${PLUGIN_DATA}/AERO_LIBRARY"
      }
    }
  }
}